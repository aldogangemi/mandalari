#################################################################
#    Object Properties - Participant Roles
#################################################################

### General participant property

:hasParticipant rdf:type owl:ObjectProperty ;
    rdfs:domain dul:Situation ;
    rdfs:range :Participant ;
    rdfs:comment "General property connecting a situation to its participants" ;
    rdfs:label "hasParticipant" .

:participantIn rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasParticipant ;
    rdfs:range dul:Situation ;
    rdfs:label "participantIn" .

### Specific semantic role properties (subproperties of hasParticipant)

:hasAccuser rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Participant who accuses in delusional contexts" ;
    rdfs:label "hasAccuser" .

:accuserOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasAccuser ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "accuserOf" .

:hasPatient rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Participant who undergoes or receives the action" ;
    rdfs:label "hasPatient" .

:patientOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasPatient ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "patientOf" .

:hasAgent rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Participant who actively performs the action described by the situation" ;
    rdfs:label "hasAgent" .

:agentOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasAgent ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "agentOf" .

:hasProtagonist rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Main character or protagonist in the delusional narrative" ;
    rdfs:label "hasProtagonist" .

:protagonistOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasProtagonist ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "protagonistOf" .

:hasExperiencer rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Participant who experiences a psychological or perceptual state" ;
    rdfs:label "hasExperiencer" .

:experiencerOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasExperiencer ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "experiencerOf" .

:hasTheme rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "The theme or central topic of the frame" ;
    rdfs:label "hasTheme" .

:themeOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasTheme ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "themeOf" .

:hasAddressee rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "The addressee of a communication" ;
    rdfs:label "hasAddressee" .

:addresseeOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasAddressee ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "addresseeOf" .

:hasSource rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "The source or origin of something" ;
    rdfs:label "hasSource" .

:sourceOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasSource ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "sourceOf" .

:hasBeneficiary rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Who benefits from the action" ;
    rdfs:label "hasBeneficiary" .

:beneficiaryOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasBeneficiary ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "beneficiaryOf" .

:hasTarget rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "The target of an action" ;
    rdfs:label "hasTarget" .

:targetOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasTarget ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "targetOf" .

:hasWriter rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Who writes the document or text" ;
    rdfs:label "hasWriter" .

:writerOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasWriter ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "writerOf" .

:hasCharacter rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Characters in a narrative" ;
    rdfs:label "hasCharacter" .

:characterOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasCharacter ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "characterOf" .

:hasAntagonist rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "The antagonist or opponent" ;
    rdfs:label "hasAntagonist" .

:antagonistOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasAntagonist ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "antagonistOf" .

:hasAccused rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Who is accused" ;
    rdfs:label "hasAccused" .

:accusedOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasAccused ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "accusedOf" .

:hasInstrument rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Instrument used for the action" ;
    rdfs:label "hasInstrument" .

:instrumentOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasInstrument ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "instrumentOf" .

:hasVictim rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Victim of an action" ;
    rdfs:label "hasVictim" .

:victimOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasVictim ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "victimOf" .

:hasRequester rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Who makes a request" ;
    rdfs:label "hasRequester" .

:requesterOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasRequester ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "requesterOf" .

:hasGoal rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "The goal to be achieved" ;
    rdfs:label "hasGoal" .

:goalOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasGoal ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "goalOf" .

:hasSubject rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "The subject being talked about" ;
    rdfs:label "hasSubject" .

:subjectOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasSubject ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "subjectOf" .

:hasLocation rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Location where the action takes place" ;
    rdfs:label "hasLocation" .

:locationOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasLocation ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "locationOf" .

:hasParticipants rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:comment "Generic participants (plural)" ;
    rdfs:label "hasParticipants" .

:participantsOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasParticipants ;
    rdfs:subPropertyOf :participantIn ;
    rdfs:label "participantsOf" .

#################################################################
#    Object Properties - Diagnosis and Occupation
#################################################################

### Disease Properties

:hasDiseaseCondition rdf:type owl:ObjectProperty ;
    rdfs:domain :Author ;
    rdfs:range :Disease ;
    rdfs:label "hasDiseaseCondition"@en ;
    rdfs:comment "Links an author to a disease condition"@en ;
    owl:inverseOf :diseaseConditionOf .

:diseaseConditionOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Disease ;
    rdfs:range :Author ;
    rdfs:label "diseaseConditionOf"@en ;
    rdfs:comment "Inverse: disease affects author"@en .

:hasMainDiseaseCondition rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDiseaseCondition ;
    rdfs:domain :Author ;
    rdfs:range :Disease ;
    rdfs:label "hasMainDiseaseCondition"@en ;
    rdfs:comment "Primary disease diagnosis"@en .

:hasAdditionalDiseaseCondition rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDiseaseCondition ;
    rdfs:domain :Author ;
    rdfs:range :Disease ;
    rdfs:label "hasAdditionalDiseaseCondition"@en ;
    rdfs:comment "Secondary or comorbid disease diagnosis"@en .

:mainDiseaseConditionOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Disease ;
    rdfs:range :Author ;
    rdfs:subPropertyOf :diseaseConditionOf ; 
    rdfs:label "mainDiseaseConditionOf"@en ;
    rdfs:comment "Inverse of hasMainDiseaseCondition: the disease is the primary diagnosis of the author."@en ;
    owl:inverseOf :hasMainDiseaseCondition .

:additionalDiseaseConditionOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Disease ;
    rdfs:range :Author ;
    rdfs:subPropertyOf :diseaseConditionOf ; 
    rdfs:label "additionalDiseaseConditionOf"@en ;
    rdfs:comment "Inverse of hasAdditionalDiseaseCondition: the disease is a secondary diagnosis of the author."@en ;
    owl:inverseOf :hasAdditionalDiseaseCondition .

### DSM-5 Category Properties

:hasDSM5Category rdf:type owl:ObjectProperty ;
    rdfs:domain :Disease ;
    rdfs:range :DSM5Category ;
    rdfs:label "hasDSM5Category"@en ;
    rdfs:comment "Maps a disease to its DSM-5 diagnostic category"@en ;
    owl:inverseOf :isDSM5CategoryOf .

:isDSM5CategoryOf rdf:type owl:ObjectProperty ;
    rdfs:domain :DSM5Category ;
    rdfs:range :Disease ;
    rdfs:label "isDSM5CategoryOf"@en ;
    rdfs:comment "Inverse: this DSM-5 category includes the disease"@en .

### Occupation Properties

:hasOccupation rdf:type owl:ObjectProperty ;
    rdfs:domain :Author ;
    rdfs:range :SpecificOccupation ;
    rdfs:label "hasOccupation"@en ;
    rdfs:comment "The occupation of the author"@en ;
    owl:inverseOf :isOccupationOf .

:isOccupationOf rdf:type owl:ObjectProperty ;
    rdfs:domain :SpecificOccupation ;
    rdfs:range :Author ;
    rdfs:label "isOccupationOf"@en ;
    rdfs:comment "Inverse: this occupation belongs to the author"@en .

:belongsToGenericOccupation rdf:type owl:ObjectProperty ;
    rdfs:domain :SpecificOccupation ; 
    rdfs:range :GenericOccupation ;      
    rdfs:comment "Links a specific occupation (instance of :SpecificOccupation) to its generic category (instance of :GenericOccupation)." ;  
    rdfs:label "belongsToGenericOccupation" .


#################################################################
#    Object Properties - Relations between main classes
#################################################################

:denotedBy rdf:type owl:ObjectProperty ;
    rdfs:domain dul:Situation ;
    rdfs:range :Document ;
    rdfs:comment "Situation appears in document" ;
    rdfs:label "denoted by" .

:denotes rdf:type owl:ObjectProperty ;
    owl:inverseOf :denotedBy ;
    rdfs:domain :Document ;
    rdfs:range dul:Situation ;
    rdfs:label "denotes" .

:hasAuthor rdf:type owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Author ;
    rdfs:label "has author" .

:isAuthorOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasAuthor ;
    rdfs:domain :Author ;
    rdfs:range :Document ;
    rdfs:label "is author o" .

:coOccursWith rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    owl:propertyChainAxiom ( 
        :denotedBy 
        [ owl:inverseOf :denotedBy ] 
    ) ;
    rdfs:domain dul:Situation ;
    rdfs:range dul:Situation ;
    rdfs:comment "Indicates that two situations appear together in the same document. Automatically inferred when two situations appear in the same document." ;
    rdfs:label "coOccurs With" .

#################################################################
#    Data Properties
#################################################################

### Author properties

:birthDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Author ;
    rdfs:range xsd:gYear ;
    rdfs:comment "Birth year of the author" ;
    rdfs:label "birthDate" .

:deathDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Author ;
    rdfs:range xsd:gYear ;
    rdfs:comment "Year of death in hospital" ;
    rdfs:label "deathDate" .

:admissionDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Author ;
    rdfs:range xsd:gYear ;
    rdfs:comment "Year of admission to the psychiatric hospital" ;
    rdfs:label "admissionDate" .

:dischargeDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Author ;
    rdfs:range xsd:gYear ;
    rdfs:comment "Year of discharge from the psychiatric hospital" ;
    rdfs:label "dischargeDate" .

### Document properties

:writingDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Document ;
    rdfs:range xsd:gYear ;
    rdfs:comment "Year when the document was written" ;
    rdfs:label "writingDate" .
### Note Properties

:birthNote rdf:type owl:DatatypeProperty ;
    rdfs:domain :Author ;
    rdfs:range xsd:string ;
    rdfs:comment "Additional notes about birth date (e.g., uncertainty, alternative dates)" ;
    rdfs:label "birthNote"@en .

:deathNote rdf:type owl:DatatypeProperty ;
    rdfs:domain :Author ;
    rdfs:range xsd:string ;
    rdfs:comment "Additional notes about death date" ;
    rdfs:label "deathNote"@en .

:dischargeNote rdf:type owl:DatatypeProperty ;
    rdfs:domain :Author ;
    rdfs:range xsd:string ;
    rdfs:comment "Additional notes about discharge (e.g., 'same year', 'transferred', 'escaped')" ;
    rdfs:label "dischargeNote"@en .

:writingNote rdf:type owl:DatatypeProperty ;
    rdfs:domain :Document ;
    rdfs:range xsd:string ;
    rdfs:comment "Additional notes about when the document was written" ;
    rdfs:label "writingNote"@en .



