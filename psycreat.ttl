@prefix : <http://www.ontologydesignpatterns.org.org/ont/psycreat.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://www.semanticweb.org/ontologies/psych-semantics> .

<http://www.ontologydesignpatterns.org.org/ont/psycreat.owl> rdf:type owl:Ontology ;
    rdfs:comment "Ontology for the semantic analysis of psychiatric texts and patient metadata based on frame semantics." ;
    rdfs:label "Ontology of psychiatric patient data and authored documents." ;
    owl:versionInfo "14" .

#################################################################
#    Classes
#################################################################

:Document rdf:type owl:Class ;
    rdfs:subClassOf dul:InformationEntity ;
    rdfs:comment "Represents analyzed psychiatric texts" ;
    rdfs:label "Document" .

:Author rdf:type owl:Class ;
    rdfs:subClassOf dul:NaturalPerson ;
    rdfs:comment "Author of psychiatric documents" ;
    rdfs:label "Author" .

:Frame rdf:type owl:Class ;
    rdfs:subClassOf dul:Description ;
    rdfs:comment "Semantic frame identified in the text" ;
    rdfs:label "Frame" .

:Participant rdf:type owl:Class ;
    rdfs:subClassOf dul:Entity ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :participantIn ;
        owl:someValuesFrom dul:Situation
    ] ;
    rdfs:comment "Entity participating in a situation evoking a semantic frame. Defined as anything that participates in at least one Situation." ;
    rdfs:label "Participant" .

### Disease Classes

:Disease rdf:type owl:Class ;
    rdfs:subClassOf dul:Event ;
    rdfs:comment "A disease or pathological condition" ;
    rdfs:label "Disease"@en .

:DSM5Category rdf:type owl:Class ;
    rdfs:subClassOf dul:Description ;
    rdfs:comment "DSM-5 diagnostic category" ;
    rdfs:label "DSM5Category" .

### Occupation Classes

:Occupation rdf:type owl:Class ;
    rdfs:subClassOf dul:Role ;
    rdfs:comment "Occupation or profession" ;
    rdfs:label "Occupation" .

### Occupation Level Classes

:GenericOccupation rdf:type owl:Class ;
    rdfs:subClassOf :Occupation ;
    rdfs:label "Occupation Type"@en ;
    rdfs:comment "Broad occupational category (e.g., Military&Police, Teaching&Education)" .


:SpecificOccupation rdf:type owl:Class ;
    rdfs:subClassOf :Occupation ; 
    rdfs:label "Specific Occupation"@en ;
    rdfs:comment "A detailed, specific profession (e.g., 'Army Officer' from the 'Occupation' column)." .

### Disjointness of main classes

[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :Document dul:Situation :Author ) .

:Participant owl:disjointWith :Document, dul:Situation .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :Disease :Occupation :Document ) .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :DSM5Category :Occupation :Document ) .
 
# [] rdf:type owl:AllDisjointClasses ;
#    owl:members ( :GenericOccupation :SpecificOccupation ) .

# :Occupation owl:disjointWith dul:Situation .

